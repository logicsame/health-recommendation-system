# .env.example
# Copy this file to .env and fill in your actual values.

# --- Backend Configuration ---

# Mistral API Key (Required for OCR functionality)
MISTRAL_API_KEY="YOUR_MISTRAL_API_KEY_HERE"

# Mistral OCR Model (Optional, defaults to mistral-ocr-latest)
# MISTRAL_OCR_MODEL="mistral-ocr-latest"

# Secret key for JWT token generation (Required for authentication)
# Use a strong, randomly generated key. You can generate one using:
# openssl rand -hex 32
SECRET_KEY="a_very_secret_key_for_jwt_should_be_in_env"

# --- Frontend Configuration (Usually set via docker-compose) ---

# Backend API URL (If running frontend outside docker-compose, point this to the backend)
# BACKEND_API_URL="http://localhost:8000/api/v1"

# --- LLM Model Configuration (Handled via paths in backend/app/core/config.py) ---
# The LLM model files should be placed in the `backend/saved_model` directory.
# Ensure the model specified in `backend/app/core/config.py` (LLM_MODEL_ID, BASE_MODEL_ID)
# matches the directory structure within `backend/saved_model`.

